# Copy to .env.local for development. Never commit real values.
# Production values live in Railway environment variables.

# Local: the docker-compose database (`npm run db:up`).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lengualearn

# Admin API (content import and status changes). Make a pair with `npm run admin:token`.
# The server checks requests against the hash; scripts on the laptop send the token.
# In Railway, set only ADMIN_API_TOKEN_HASH.
ADMIN_API_TOKEN_HASH=
ADMIN_API_TOKEN=

# Better Auth. Make a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's public URL and the one origin sign-in trusts (default http://localhost:3000).
# Set per environment in .railway/railway.ts.
# BETTER_AUTH_URL=
# Google sign-in for teachers and independent learners (optional; off when unset).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo site mode: a banner, the fixture words allowed, and one-click "Try it" accounts.
# Set on the demo environment (try.lengualearn.com), never on production.
DEMO_SITE=1
# Demo site: 0 stops building ready-made demo accounts ahead of time (CI sets it, so pool
# builds don't load the server mid-test). Visitors then get one built on the spot.
# DEMO_PREBUILD=0
# Real site only: accounts stay closed ("Opening soon") in Railway production until this is 1.
# SIGNUPS_OPEN=1
# Where the real site's "Try the demo" buttons go (default https://try.lengualearn.com).
# DEMO_URL=

# Email: "console" prints messages to the server log (the default outside production). In
# production nothing sends until SES is set up.
# EMAIL_TRANSPORT=console
# Where media files are served from (default: this site's own /public). Later: the CloudFront audio domain.
# MEDIA_BASE_URL=
