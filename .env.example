# Copy to .env.local for development. Never commit real values.
# Production values live in Railway environment variables.

# Local: the docker-compose database (`npm run db:up`).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lengualearn

# Admin API (content import and status changes). Make a pair with `npm run admin:token`.
# The server checks requests against the hash; scripts on the laptop send the token.
# In Railway, set only ADMIN_API_TOKEN_HASH.
ADMIN_API_TOKEN_HASH=
ADMIN_API_TOKEN=

# Training as a hard-coded dev user, until accounts exist (Phase 4). Never set in production.
ENABLE_DEV_USER=1
